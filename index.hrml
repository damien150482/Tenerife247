<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tenerife 24/7 - Répertoire Officiel & Espace Membres</title>
    <!-- FontAwesome pour les icônes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #0284c7;
            --primary-dark: #0369a1;
            --accent: #f59e0b;
            --bg-dark: #0f172a;
            --bg-light: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --success: #10b981;
            --danger: #ef4444;
            --radius: 12px;
            --shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-main);
            line-height: 1.6;
        }

        #t247-wrapper {
            background-color: var(--bg-light);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            max-width: 1200px;
            margin: 20px auto;
            position: relative;
            border: 1px solid var(--border);
        }

        /* PORTAIL D'ACCÈS / PAYWALL OBLIGATOIRE */
        #t247-auth-gate {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 58, 138, 0.95) 100%);
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            overflow-y: auto;
        }

        .gate-card {
            background: #ffffff;
            max-width: 550px;
            width: 100%;
            padding: 30px;
            border-radius: var(--radius);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            text-align: center;
        }

        .gate-card h2 {
            color: var(--bg-dark);
            margin-bottom: 10px;
            font-size: 24px;
        }

        .gate-card p {
            color: var(--text-muted);
            margin-bottom: 25px;
            font-size: 15px;
        }

        .gate-btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            margin-bottom: 12px;
            transition: background 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .gate-btn:hover { background: var(--primary-dark); }
        .gate-btn.stripe-btn { background: #635bff; }
        .gate-btn.stripe-btn:hover { background: #4b42db; }
        .gate-btn.trial-btn { background: var(--accent); color: #000; }
        .gate-btn.pro-btn { background: var(--success); }

        /* BARRE DE STATUT & ADMIN */
        #t247-status-bar {
            background: var(--bg-dark);
            color: #fff;
            padding: 12px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            font-size: 14px;
        }
        .t247-badge-admin {
            background: var(--success);
            color: #fff;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 12px;
        }

        /* EN-TÊTE PRINCIPAL */
        .t247-header {
            background: #ffffff;
            padding: 25px;
            text-align: center;
            border-bottom: 2px solid var(--border);
        }
        .t247-header h1 {
            margin: 0;
            font-size: 28px;
            color: var(--bg-dark);
        }
        .t247-domain-tag {
            display: inline-block;
            background: #e0f2fe;
            color: var(--primary-dark);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            margin-top: 8px;
        }

        /* BANDEAU TICKER / ALERTES LIVE */
        .ticker-container {
            background: var(--accent);
            color: #000;
            overflow: hidden;
            white-space: nowrap;
            padding: 10px 0;
            font-weight: bold;
            font-size: 14px;
        }
        .ticker-text {
            display: inline-block;
            animation: marquee 30s linear infinite;
        }
        @keyframes marquee {
            0% { transform: translate3d(100%, 0, 0); }
            100% { transform: translate3d(-100%, 0, 0); }
        }

        /* CONTENU DE L'ANNUAIRE */
        #t247-main-content {
            padding: 30px;
        }

        .section-title {
            background: var(--bg-dark);
            color: #fff;
            padding: 14px 20px;
            border-radius: 8px;
            font-size: 18px;
            margin: 30px 0 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* FILTRES PAR DISTRICTS */
        .district-filter {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 10px;
            margin-bottom: 25px;
        }
        .district-btn {
            background: #fff;
            border: 1px solid var(--border);
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            white-space: nowrap;
            font-weight: 600;
            font-size: 14px;
            color: var(--text-main);
            transition: all 0.2s;
        }
        .district-btn.active, .district-btn:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        /* ACCORDÉONS */
        .t247-accordion-item {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            margin-bottom: 12px;
            overflow: hidden;
            transition: all 0.2s ease;
        }
        .t247-accordion-header {
            width: 100%;
            background: #fff;
            border: none;
            padding: 16px 20px;
            text-align: left;
            font-size: 16px;
            font-weight: 700;
            color: var(--text-main);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .t247-accordion-header:hover { background: #f1f5f9; }
        .t247-accordion-icon {
            font-size: 16px;
            color: var(--primary);
            transition: transform 0.3s;
        }
        .t247-accordion-item.open .t247-accordion-icon { transform: rotate(180deg); }
        .t247-accordion-body {
            display: none;
            padding: 20px;
            background: #f8fafc;
            border-top: 1px solid var(--border);
        }

        /* GRILLES & CARTES DES TABLES */
        .directory-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        .directory-card {
            background: #ffffff;
            border: 1px solid var(--border);
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid var(--primary);
        }
        .directory-card h4 {
            color: var(--primary-dark);
            margin-bottom: 6px;
            font-size: 15px;
        }
        .directory-card p {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 6px;
        }
        .badge-tag {
            display: inline-block;
            background: #e0f2fe;
            color: var(--primary-dark);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            margin-top: 5px;
        }

        /* PIED DE PAGE */
        footer {
            background: var(--bg-dark);
            color: #fff;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
            font-size: 14px;
        }
        footer a { color: var(--accent); text-decoration: none; }
    </style>
</head>
<body>

    <!-- PORTAIL D'ACCÈS / PAYWALL (Bloque les non-abonnés sauf Damien via ?admin=damien) -->
    <div id="t247-auth-gate">
        <div class="gate-card">
            <h2>Tenerife 24/7 - Portail d'Accès Exclusif</h2>
            <p>Accès sécurisé réservé aux membres abonnés et aux propriétaires partenaires. Choisissez votre formule ou connectez-vous.</p>
            
            <a href="https://buy.stripe.com/votre-lien-stripe-pass-touriste" target="_blank" class="gate-btn stripe-btn">
                <i class="fa-solid fa-credit-card"></i> S'abonner (Pass Touriste / Particulier)
            </a>
            <button class="gate-btn trial-btn" onclick="startFreeTrial()">
                <i class="fa-solid fa-clock"></i> Essai gratuit (15 minutes)
            </button>
            <a href="mailto:damien19821@outlook.fr?subject=Espace Pro Tenerife 24/7" class="gate-btn pro-btn">
                <i class="fa-solid fa-briefcase"></i> Espace Propriétaires & Professionnels
            </a>
        </div>
    </div>

    <!-- CONTENEUR PRINCIPAL DU SITE -->
    <div id="t247-wrapper">

        <!-- BARRE DE STATUT SUPÉRIEURE -->
        <div id="t247-status-bar">
            <span><i class="fa-solid fa-shield-halved"></i> Site Officiel Tenerife 24/7</span>
            <div>
                <span id="user-status-badge" class="t247-badge-admin">Visiteur</span>
                <span id="timer-display" style="margin-left: 10px; display: none;" class="t247-badge-timer">15:00</span>
            </div>
        </div>

        <!-- EN-TÊTE -->
        <header class="t247-header">
            <h1>Tenerife 24h/24 & 7j/7</h1>
            <div class="t247-domain-tag">tenerife247.wordpress.com</div>
        </header>

        <!-- BANDEAU D'INFORMATIONS EN DIRECT -->
        <div class="ticker-container">
            <div class="ticker-text">
                🔥 Alertes Live : Soirée Salsa SBK ce soir à El Médano • 🚐 Spot Vanlife mis à jour à Anaga • ☀️ 24°C et grand soleil au Sud • Contact Admin Damien : +33 6 15 32 72 87
            </div>
        </div>

        <!-- CONTENU DE L'ANNUAIRE -->
        <main id="t247-main-content">

            <!-- FILTRE GÉOGRAPHIQUE PAR DISTRICTS -->
            <div class="district-filter">
                <button class="district-btn active" onclick="filterDistrict('all')">Toutes les Zones</button>
                <button class="district-btn" onclick="filterDistrict('south')">Sud (Touristique & Festif)</button>
                <button class="district-btn" onclick="filterDistrict('north')">Nord (Authentique & Nature)</button>
                <button class="district-btn" onclick="filterDistrict('metro')">Métropole & Est</button>
                <button class="district-btn" onclick="filterDistrict('west')">Ouest & Intérieur</button>
            </div>

            <h3 class="section-title">
                <span><i class="fa-solid fa-folder-tree"></i> Répertoire Complet & Tables Interconnectées</span>
                <span style="font-size: 13px; font-weight: normal;">25 Tables Officielles</span>
            </h3>

            <!-- ACCORDÉON 1 : HÉBERGEMENT & SÉJOUR -->
            <div class="t247-accordion-item">
                <button class="t247-accordion-header" onclick="toggleAccordion(this)">
                    <span><i class="fa-solid fa-bed"></i> 1. Hébergements & Séjour (Logement & Vanlife)</span>
                    <i class="fa-solid fa-chevron-down t247-accordion-icon"></i>
                </button>
                <div class="t247-accordion-body">
                    <p>Répertoire des logements, colivings, hôtels et aires de stationnement pour camping-cars et vans.</p>
                    <div class="directory-grid">
                        <div class="directory-card">
                            <h4>Campervans & Aires de Stationnement</h4>
                            <p>Spots autorisés, points d'eau, stations de vidange et vanlife friendly.</p>
                            <span class="badge-tag">Indispensable Vanlifers</span>
                        </div>
                        <div class="directory-card">
                            <h4>Appartements & Studios</h4>
                            <p>Locations de vacances vérifiées gérées par des hôtes locaux.</p>
                            <span class="badge-tag">Toutes Zones</span>
                        </div>
                        <div class="directory-card">
                            <h4>Coliving & Coworking</h4>
                            <p>Espaces adaptés pour nomades digitaux avec Wi-Fi haut débit.</p>
                            <span class="badge-tag">El Médano / La Laguna</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ACCORDÉON 2 : RESTAURATION, BARS & NIGHTLIFE -->
            <div class="t247-accordion-item">
                <button class="t247-accordion-header" onclick="toggleAccordion(this)">
                    <span><i class="fa-solid fa-martini-glass-citrus"></i> 2. Restauration, Bars & Soirées SBK</span>
                    <i class="fa-solid fa-chevron-down t247-accordion-icon"></i>
                </button>
                <div class="t247-accordion-body">
                    <p>Guachinches traditionnels, bars de nuit, concerts live et soirées Salsa, Bachata, Kizomba.</p>
                    <div class="directory-grid">
                        <div class="directory-card">
                            <h4>Soirées Salsa, Bachata & Kizomba (SBK)</h4>
                            <p>Agenda des lieux de danse sociale, cours et soirées latines.</p>
                            <span class="badge-tag">Table Événements</span>
                        </div>
                        <div class="directory-card">
                            <h4>Guachinches & Restos Locaux</h4>
                            <p>Gastronomie authentique, vin de Tenerife et tapas faits maison.</p>
                            <span class="badge-tag">Nord & Rural</span>
                        </div>
                        <div class="directory-card">
                            <h4>Coffee Shops & Cannabis Clubs</h4>
                            <p>Informations légales, guides et adresses référencées pour touristes.</p>
                            <span class="badge-tag">Forte Demande</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ACCORDÉON 3 : LOISIRS, ACTIVITÉS & MER -->
            <div class="t247-accordion-item">
                <button class="t247-accordion-header" onclick="toggleAccordion(this)">
                    <span><i class="fa-solid fa-compass"></i> 3. Loisirs, Activités & Sorties en Mer</span>
                    <i class="fa-solid fa-chevron-down t247-accordion-icon"></i>
                </button>
                <div class="t247-accordion-body">
                    <p>Excursions en mer, observation des baleines, randonnées Teide / Anaga et spots de surf.</p>
                    <div class="directory-grid">
                        <div class="directory-card">
                            <h4>Pêche en Mer & Spearfishing</h4>
                            <p>Réglementations, zones autorisées et conseils d'experts locaux.</p>
                            <span class="badge-tag">Océan</span>
                        </div>
                        <div class="directory-card">
                            <h4>Randonnées & Nature (Teide / Masca)</h4>
                            <p>Difficultés, durées estimées, dénivelés et points d'eau utiles.</p>
                            <span class="badge-tag">Sentiers</span>
                        </div>
                        <div class="directory-card">
                            <h4>Surf, Kitesurf & Parapente</h4>
                            <p>Spots incontournables à El Médano, écoles et locations de matériel.</p>
                            <span class="badge-tag">Aventure</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ACCORDION 4 : BIEN-ÊTRE, BEAUTÉ & SANTÉ -->
            <div class="t247-accordion-item">
                <button class="t247-accordion-header" onclick="toggleAccordion(this)">
                    <span><i class="fa-solid fa-spa"></i> 4. Bien-être, Beauté & Santé</span>
                    <i class="fa-solid fa-chevron-down t247-accordion-icon"></i>
                </button>
                <div class="t247-accordion-body">
                    <p>Salons de massage, produits naturels à l'aloe vera, spas et salles de sport.</p>
                    <div class="directory-grid">
                        <div class="directory-card">
                            <h4>Massages & Praticiens Indépendants</h4>
                            <p>Massages bien-être, relaxants et soins professionnels (Hommes / Femmes).</p>
                            <span class="badge-tag">Détente</span>
                        </div>
                        <div class="directory-card">
                            <h4>Boutiques Aloe Vera & Produits Locaux</h4>
                            <p>Cosmétiques naturels canariens et huiles essentielles.</p>
                            <span class="badge-tag">Artisanat</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ACCORDION 5 : SERVICES PRATIQUES & VANLIFE -->
            <div class="t247-accordion-item">
                <button class="t247-accordion-header" onclick="toggleAccordion(this)">
                    <span><i class="fa-solid fa-wrench"></i> 5. Services Pratiques & Logistique</span>
                    <i class="fa-solid fa-chevron-down t247-accordion-icon"></i>
                </button>
                <div class="t247-accordion-body">
                    <p>Garages mécaniques, laveries automatiques, pharmacies de garde et urgences.</p>
                    <div class="directory-grid">
                        <div class="directory-card">
                            <h4>Garages & Dépannage Mécanique</h4>
                            <p>Assistance pour véhicules, vans aménagés et voitures de location.</p>
                            <span class="badge-tag">Vanlife</span>
                        </div>
                        <div class="directory-card">
                            <h4>Urgences & Santé</h4>
                            <p>Pharmacies de garde, hôpitaux et numéros d'assistance 24/7.</p>
                            <span class="badge-tag">Sécurité</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ACCORDION 6 : ESPACE PRO & FORMULES -->
            <div class="t247-accordion-item">
                <button class="t247-accordion-header" onclick="toggleAccordion(this)">
                    <span><i class="fa-solid fa-handshake"></i> 6. Espace Pro & Inscription Partenaires</span>
                    <i class="fa-solid fa-chevron-down t247-accordion-icon"></i>
                </button>
                <div class="t247-accordion-body">
                    <div style="text-align: center; padding: 10px;">
                        <h4>Référencez votre établissement sur Tenerife 24/7</h4>
                        <p style="margin: 10px 0 15px; color: var(--text-muted);">Formules publicitaires adaptées pour commerçants et prestataires (Gratuit à 69€).</p>
                        <a href="https://buy.stripe.com/votre-lien-stripe-pro" target="_blank" class="gate-btn stripe-btn" style="max-width: 300px; margin: 0 auto;">
                            <i class="fa-solid fa-credit-card"></i> Payer l'adhésion Pro
                        </a>
                    </div>
                </div>
            </div>

        </main>

        <!-- PIED DE PAGE -->
        <footer>
            <p><strong>Tenerife 24/7</strong> - Le Répertoire Officiel</p>
            <p style="margin-top: 5px;">Propriétaire & Administrateur : <strong>Damien</strong> | Email : <a href="mailto:damien19821@outlook.fr">damien19821@outlook.fr</a> | Tél : +33 6 15 32 72 87</p>
        </footer>

    </div>

    <!-- SCRIPT DE GESTION DES ACCÈS, DE L'ADMIN ET DU TIMER D'ESSAI -->
    <script>
        // 1. Détection automatique du mode Admin via l'URL (?admin=damien)
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('admin') === 'damien') {
            document.getElementById('t247-auth-gate').style.display = 'none';
            const badge = document.getElementById('user-status-badge');
            badge.innerText = 'Administrateur : Damien';
            badge.className = 't247-badge-admin';
        }

        // 2. Fonction d'octroi de l'essai gratuit (15 minutes)
        function startFreeTrial() {
            document.getElementById('t247-auth-gate').style.display = 'none';
            const badge = document.getElementById('user-status-badge');
            badge.innerText = 'Essai Gratuit';
            badge.style.background = 'var(--accent)';
            badge.style.color = '#000';

            // Affichage et gestion du compte à rebours de 15 minutes
            const timerDisplay = document.getElementById('timer-display');
            timerDisplay.style.display = 'inline-block';
            
            let timeLeft = 15 * 60; // 15 minutes en secondes
            const countdown = setInterval(() => {
                let minutes = Math.floor(timeLeft / 60);
                let seconds = timeLeft % 60;
                timerDisplay.innerText = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
                
                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    alert("Votre période d'essai gratuite de 15 minutes est expirée. Veuillez souscrire à un Pass pour continuer.");
                    document.getElementById('t247-auth-gate').style.display = 'flex';
                }
                timeLeft--;
            }, 1000);
        }

        // 3. Gestion des accordéons
        function toggleAccordion(button) {
            const item = button.parentElement;
            const allItems = document.querySelectorAll('.t247-accordion-item');
            
            allItems.forEach(i => {
                if (i !== item) {
                    i.classList.remove('open');
                    i.querySelector('.t247-accordion-body').style.display = 'none';
                }
            });
            
            item.classList.toggle('open');
            const body = item.querySelector('.t247-accordion-body');
            body.style.display = item.classList.contains('open') ? 'block' : 'none';
        }

        // 4. Gestion des filtres de districts
        function filterDistrict(zone) {
            const buttons = document.querySelectorAll('.district-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            // Logique de filtrage par zone prête à être connectée à vos bases de données
        }
    </script>
</body>
</html>
