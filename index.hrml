<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tenerife 24/7 — Répertoire Officiel & Espace Membres</title>
    <!-- Leaflet CSS pour la carte interactive -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        :root {
            --primary: #0284c7;
            --primary-dark: #0369a1;
            --accent: #f59e0b;
            --bg-dark: #0f172a;
            --bg-light: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --success: #10b981;
            --radius: 12px;
            --shadow: 0 10px 30px rgba(0,0,0,0.08);
        }
        body.dark-mode {
            --bg-dark: #020617;
            --bg-light: #090d16;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, sans-serif; transition: background 0.3s, color 0.3s; }
        body { background-color: var(--bg-light); color: var(--text-main); line-height: 1.6; }
        
        header { background: var(--bg-dark); color: white; padding: 2rem 1rem; text-align: center; position: relative; }
        header h1 { font-size: 2.2rem; margin-bottom: 0.3rem; }
        .domain-tag { display: inline-block; background: #e0f2fe; color: var(--primary-dark); padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; margin-top: 5px; }

        #google_translate_element { position: absolute; top: 15px; right: 15px; z-index: 100; }
        .goog-te-combo { padding: 5px; border-radius: 6px; border: 1px solid #ccc; font-size: 12px; }
        .btn-theme { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.3); color: white; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px; position: absolute; top: 15px; right: 155px; z-index: 100; font-weight: bold; }

        .container { max-width: 1200px; margin: 0 auto; padding: 1.5rem; }

        .pricing-wrapper { background: var(--card-bg); border-radius: var(--radius); padding: 2rem; margin-bottom: 2rem; box-shadow: var(--shadow); border: 1px solid var(--border); }
        .tabs { display: flex; justify-content: center; gap: 10px; margin-bottom: 1.5rem; flex-wrap: wrap; }
        .tab-btn { padding: 10px 20px; border: 2px solid var(--primary); background: transparent; color: var(--primary); font-weight: bold; border-radius: 20px; cursor: pointer; }
        .tab-btn.active { background: var(--primary); color: white; }
        
        .pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
        .price-card { border: 1px solid var(--border); border-radius: 8px; padding: 1.2rem; text-align: center; display: flex; flex-direction: column; justify-content: space-between; background: var(--card-bg); }
        .price-card.popular { border: 2px solid var(--accent); background: var(--card-bg); }
        .price-card h3 { font-size: 1.1rem; color: var(--text-main); margin-bottom: 5px; }
        .price-amount { font-size: 1.5rem; font-weight: 800; color: var(--primary); margin: 8px 0; }
        .price-sub { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 12px; }
        .btn-stripe { background: #635bff; color: white; border: none; padding: 10px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; transition: background 0.2s; text-decoration: none; display: inline-block; }
        .btn-stripe:hover { background: #4b42db; }

        .profile-pills { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 1rem; scrollbar-width: none; }
        .profile-pills::-webkit-scrollbar { display: none; }
        .pill-btn { background: var(--card-bg); border: 1px solid var(--border); color: var(--text-main); padding: 8px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; cursor: pointer; white-space: nowrap; box-shadow: var(--shadow); }
        .pill-btn.active { background: var(--primary); color: white; border-color: var(--primary); }

        .controls-row { display: flex; gap: 10px; margin-bottom: 1.5rem; flex-wrap: wrap; align-items: center; }
        .btn-geo { background: var(--success); color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 6px; }
        .btn-geo:hover { background: #059669; }

        #map { width: 100%; height: 400px; border-radius: var(--radius); margin-bottom: 2rem; box-shadow: var(--shadow); border: 1px solid var(--border); z-index: 1; }

        .alphabet-bar { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; margin-bottom: 1.5rem; }
        .alpha-btn { background: var(--card-bg); border: 1px solid var(--border); padding: 5px 10px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 0.85rem; color: var(--text-main); }
        .alpha-btn.active, .alpha-btn:hover { background: var(--primary); color: white; border-color: var(--primary); }

        .category-section { margin-bottom: 2.5rem; }
        .category-title { font-size: 1.4rem; color: var(--text-main); margin-bottom: 1rem; padding-bottom: 0.4rem; border-bottom: 2px solid var(--primary); display: flex; align-items: center; gap: 10px; }
        
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.2rem; }
        .card { background: var(--card-bg); border-radius: var(--radius); padding: 1.4rem; box-shadow: var(--shadow); position: relative; border-left: 4px solid var(--primary); border: 1px solid var(--border); }
        .card.premium { border-left: 4px solid var(--accent); }
        .badge-pro { position: absolute; top: 12px; right: 45px; background: var(--accent); color: #000; font-size: 0.72rem; font-weight: bold; padding: 3px 8px; border-radius: 10px; }
        .fav-btn { position: absolute; top: 12px; right: 12px; background: var(--card-bg); border: 1px solid var(--border); border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 14px; color: #ef4444; }
        .promo-badge { font-size: 0.72rem; background: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 4px; font-weight: bold; margin-left: 6px; }
        .status-badge { font-size: 0.72rem; background: #e0f2fe; color: var(--primary-dark); padding: 2px 8px; border-radius: 4px; font-weight: bold; margin-bottom: 8px; display: inline-block; }
        .tag { display: inline-block; background: rgba(2, 132, 199, 0.1); color: var(--primary); font-size: 0.78rem; padding: 2px 8px; border-radius: 4px; margin-bottom: 8px; font-weight: 600; }
        .card h3 { margin-bottom: 0.4rem; font-size: 1.2rem; color: var(--text-main); }
        .card p { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem; }
        .card-footer { display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; border-top: 1px solid var(--border); padding-top: 10px; }
        .locked-contact { color: var(--accent); font-weight: bold; cursor: pointer; text-decoration: underline; }
    </style>
</head>
<body id="pageBody">

<header>
    <button class="btn-theme" onclick="toggleDarkMode()" id="themeBtn">🌙 Nuit</button>
    <div id="google_translate_element"></div>
    <h1>Tenerife 24/7</h1>
    <div class="domain-tag">damien150482.github.io</div>
</header>

<div class="container">
    <div class="pricing-wrapper">
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('touriste')">🌴 Pass Touristes & Voyageurs</button>
            <button class="tab-btn" onclick="switchTab('pro')">💼 Espace Professionnels</button>
        </div>

        <div class="pricing-grid" id="gridTouriste">
            <div class="price-card">
                <div><h3>Pass 24 Heures</h3><div class="price-amount">3,00 €</div><p class="price-sub">Accès immédiat et illimité 24h</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_PASS_24H" target="_blank" class="btn-stripe">Acheter le Pass</a>
            </div>
            <div class="price-card">
                <div><h3>Pass Semaine</h3><div class="price-amount">7,00 €</div><p class="price-sub">7 jours d'accès complet à l'annuaire</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_PASS_SEMAINE" target="_blank" class="btn-stripe">Acheter le Pass</a>
            </div>
            <div class="price-card">
                <div><h3>Pass Tribu / Duo</h3><div class="price-amount">12,00 €</div><p class="price-sub">Séjour groupé / couples en van</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_PASS_DUO" target="_blank" class="btn-stripe">Acheter le Pass</a>
            </div>
            <div class="price-card popular">
                <div><h3>Pass Intégral (1 Mois)</h3><div class="price-amount">15,00 €</div><p class="price-sub">Pour nomades et longs séjours</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_PASS_MOIS" target="_blank" class="btn-stripe">S'abonner</a>
            </div>
        </div>

        <div class="pricing-grid" id="gridPro" style="display: none;">
            <div class="price-card">
                <div><h3>Pass Pro à la Journée</h3><div class="price-amount">5,00 €</div><p class="price-sub">Annonce éclair de dernière minute</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_PRO_JOUR" target="_blank" class="btn-stripe">Activer</a>
            </div>
            <div class="price-card">
                <div><h3>Pass Pro Coup de Projecteur</h3><div class="price-amount">10,00 €</div><p class="price-sub">Épinglé en haut pendant 48h</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_PRO_VIP" target="_blank" class="btn-stripe">Booster</a>
            </div>
            <div class="price-card">
                <div><h3>Pass Pro Événement (Semaine)</h3><div class="price-amount">15,00 €</div><p class="price-sub">Promo intensive soirée SBK / concert</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_PRO_EVENT" target="_blank" class="btn-stripe">Activer</a>
            </div>
            <div class="price-card">
                <div><h3>Option Pack Annonce Flash</h3><div class="price-amount">8,00 €</div><p class="price-sub">Offre flash / dernière minute</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_FLASH" target="_blank" class="btn-stripe">Activer</a>
            </div>
            <div class="price-card">
                <div><h3>Option Vitrine Premium</h3><div class="price-amount">22,00 €</div><p class="price-sub">Bouton WhatsApp direct / Leads</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_VITRINE" target="_blank" class="btn-stripe">Souscrire</a>
            </div>
            <div class="price-card popular">
                <div><h3>Partenaire Mensuel</h3><div class="price-amount">29,00 €</div><p class="price-sub">Visibilité continue permanente</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_PRO_MENSUEL" target="_blank" class="btn-stripe">S'abonner</a>
            </div>
            <div class="price-card">
                <div><h3>Partenaire Annuel</h3><div class="price-amount">250,00 €</div><p class="price-sub">Une année entière au meilleur tarif</p></div>
                <a href="https://buy.stripe.com/TON_LIEN_STRIPE_PRO_ANNUEL" target="_blank" class="btn-stripe">S'abonner 1 an</a>
            </div>
        </div>
    </div>

    <!-- SÉLECTEUR DE PROFIL RAPIDE (PILLS DÉFILANT) -->
    <div class="profile-pills">
        <button class="pill-btn active" onclick="setProfile('', this)">🌐 Tous les profils</button>
        <button class="pill-btn" onclick="setProfile('vanlife', this)">🚐 Vanlifer & Nomade</button>
        <button class="pill-btn" onclick="setProfile('sbk', this)">💃 Danseur Salsa & SBK</button>
        <button class="pill-btn" onclick="setProfile('night', this)">🌙 Fête & Vie Nocturne</button>
        <button class="pill-btn" onclick="setProfile('sante', this)">🩺 Santé & Urgences</button>
        <button class="pill-btn" onclick="setProfile('touriste', this)">🏖️ Touriste & Plage</button>
        <button class="pill-btn" onclick="setProfile('zen', this)">💆 Bien-être & Soins</button>
    </div>

    <div class="controls-row">
        <button class="btn-geo" onclick="locateUser()">📍 Centrer sur ma position GPS</button>
    </div>

    <!-- CARTE GÉOGRAPHIQUE INTERACTIVE -->
    <div id="map"></div>

    <div class="alphabet-bar" id="alphabetBar"></div>

    <div id="resultsContainer"></div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script type="text/javascript">
function googleTranslateElementInit() {
  new google.translate.TranslateElement({pageLanguage: 'fr', includedLanguages: 'en,es,zh-CN,de,it,fr', layout: google.translate.TranslateElement.InlineLayout.SIMPLE}, 'google_translate_element');
}
</script>
<script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

<script>
    const AIRTABLE_TOKEN = "TON_TOKEN_AIRTABLE_ICI";
    const AIRTABLE_BASE_ID = "TON_BASE_ID_ICI";
    const TABLE_NAME = "Professionnels";

    let isTouristSubscribed = localStorage.getItem("tenerife_pass_active") === "true";
    if (window.location.search.includes("payment=success")) {
        localStorage.setItem("tenerife_pass_active", "true");
        isTouristSubscribed = true;
    }

    let currentLetter = "";
    let activeProfile = "";
    let favorites = JSON.parse(localStorage.getItem("tenerife_favorites") || "[]");
    let userCoords = null;

    const map = L.map('map').setView([28.2916, -16.6291], 10);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    let markersLayer = L.layerGroup().addTo(map);
    let userMarker = null;

    let isDarkMode = localStorage.getItem("tenerife_dark_mode") === "true";
    if (isDarkMode) {
        document.getElementById("pageBody").classList.add("dark-mode");
        document.getElementById("themeBtn").textContent = "☀️ Jour";
    }

    function toggleDarkMode() {
        isDarkMode = !isDarkMode;
        document.getElementById("pageBody").classList.toggle("dark-mode", isDarkMode);
        document.getElementById("themeBtn").textContent = isDarkMode ? "☀️ Jour" : "🌙 Nuit";
        localStorage.setItem("tenerife_dark_mode", isDarkMode);
    }

    function switchTab(type) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.textContent.toLowerCase().includes(type)));
        document.getElementById("gridTouriste").style.display = type === "touriste" ? "grid" : "none";
        document.getElementById("gridPro").style.display = type === "pro" ? "grid" : "none";
    }

    function setProfile(profile, btn) {
        document.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeProfile = profile;
        resetAndFetch();
    }

    const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
    const alphaBar = document.getElementById("alphabetBar");
    alphaBar.innerHTML = `<button class="alpha-btn active" onclick="selectLetter('', this)">Tous</button>`;
    alphabet.forEach(letter => { alphaBar.innerHTML += `<button class="alpha-btn" onclick="selectLetter('${letter}', this)">${letter}</button>`; });

    function selectLetter(letter, btn) {
        document.querySelectorAll('.alpha-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentLetter = letter;
        resetAndFetch();
    }

    function resetAndFetch() { 
        document.getElementById("resultsContainer").innerHTML = ""; 
        fetchPros(); 
    }

    function toggleFavorite(id, event) {
        event.stopPropagation();
        const index = favorites.indexOf(id);
        if (index > -1) {
            favorites.splice(index, 1);
        } else {
            favorites.push(id);
        }
        localStorage.setItem("tenerife_favorites", JSON.stringify(favorites));
        resetAndFetch();
    }

    function locateUser() {
        if (!navigator.geolocation) {
            alert("La géolocalisation n'est pas supportée par votre navigateur.");
            return;
        }
        navigator.geolocation.getCurrentPosition(
            (position) => {
                userCoords = {
                    lat: position.coords.latitude,
                    lng: position.coords.longitude
                };
                map.setView([userCoords.lat, userCoords.lng], 13);
                
                if (userMarker) {
                    map.removeLayer(userMarker);
                }
                userMarker = L.marker([userCoords.lat, userCoords.lng], {
                    title: "Ma position GPS"
                }).addTo(map).bindPopup("<b>Vous êtes ici 📍</b>").openPopup();
            },
            () => {
                alert("Impossible d'obtenir votre position GPS.");
            }
        );
    }

    async function fetchPros() {
        if (AIRTABLE_TOKEN === "TON_TOKEN_AIRTABLE_ICI") { renderDemoData(); return; }

        let formulas = [];
        if (currentLetter) formulas.push(`LEFT(UPPER({Nom}), 1) = '${currentLetter}'`);

        let filterFormula = formulas.length > 0 ? `AND(${formulas.join(",")})` : "";
        let url = `https://api.airtech.com/...`; // Gardé pour ta structure Airtable
        // (La suite s'adapte à ton API Airtable)
    }

    function renderGroupedCategories(items) {
        const container = document.getElementById("resultsContainer");
        container.innerHTML = "";
        markersLayer.clearLayers();

        if (!items || items.length === 0) {
            container.innerHTML = `<div style="text-align:center; padding:3rem; color:var(--text-muted);">Aucun résultat trouvé.</div>`;
            return;
        }

        items.sort((a, b) => {
            let catA = (a.Categorie || "Autres").toLowerCase();
            let catB = (b.Categorie || "Autres").toLowerCase();
            if (catA < catB) return -1;
            if (catA > catB) return 1;
            let nameA = (a.Nom || "").toLowerCase();
            let nameB = (b.Nom || "").toLowerCase();
            return nameA.localeCompare(nameB);
        });

        const grouped = {};
        items.forEach(pro => {
            const cat = pro.Categorie || "Autres";
            if (!grouped[cat]) grouped[cat] = [];
            grouped[cat].push(pro);

            if (pro.Latitude && pro.Longitude) {
                const marker = L.marker([parseFloat(pro.Latitude), parseFloat(pro.Longitude)]);
                marker.bindPopup(`<b>${pro.Nom}</b><br><small>${cat}</small><br>${pro.Description || ''}`);
                markersLayer.addLayer(marker);
            }
        });

        let htmlOutput = "";
        for (const [category, pros] of Object.entries(grouped)) {
            let sectionHTML = `
                <div class="category-section">
                    <h2 class="category-title">📂 ${category} (${pros.length})</h2>
                    <div class="grid">
            `;

            pros.forEach(pro => {
                const proId = pro.id || pro.Nom;
                const isFav = favorites.includes(proId);
                const isPremium = pro.Premium ? "premium" : "";
                const badge = pro.Premium ? `<span class="badge-pro">★ VIP / Partenaire</span>` : "";
                const promoTag = pro.Promo ? `<span class="promo-badge">🎟️ Avantage Pass</span>` : "";
                const statusBadge = pro.Ouvert247 ? `<span class="status-badge">🟢 Ouvert 24/7</span>` : `<span class="status-badge">🟢 Service Actif</span>`;
                const contactHTML = isTouristSubscribed 
                    ? `<span>📞 ${pro.Telephone}</span><a href="https://wa.me/${pro.Telephone.replace(/[^0-9]/g, '')}" target="_blank" style="color: var(--primary); font-weight: bold; text-decoration: none;">WhatsApp →</a>`
                    : `<span class="locked-contact" onclick="alert('Veuillez activer votre Pass sur le catalogue en haut pour voir les contacts directs.')">🔒 Contact réservé aux abonnés Pass</span>`;

                sectionHTML += `
                    <div class="card ${isPremium}">
                        ${badge}
                        <button class="fav-btn" onclick="toggleFavorite('${proId}', event)" title="Ajouter aux favoris">${isFav ? '♥' : '♡'}</button>
                        ${statusBadge}
                        <span class="tag">${pro.Zone || 'Toute l\'île'}</span> ${promoTag}
                        <h3>${pro.Nom}</h3>
                        <p>${pro.Description}</p>
                        <div class="card-footer">${contactHTML}</div>
                    </div>
                `;
            });

            sectionHTML += `</div></div>`;
            htmlOutput += sectionHTML;
        }
        container.innerHTML = htmlOutput;
    }

    function renderDemoData() {
        let demo = [
            { id: "1", Nom: "Bajamar Piscines Naturelles", Categorie: "Plages & Piscines Naturelles", Zone: "Nord", Telephone: "+34922112233", Description: "Bassin d'eau de mer sécurisé.", Premium: false, Promo: true, Ouvert247: true, Latitude: 28.5600, Longitude: -16.3500 },
            { id: "2", Nom: "Playa de Las Teresitas", Categorie: "Plages & Piscines Naturelles", Zone: "Metropole", Telephone: "+34922001122", Description: "Grande plage de sable doré.", Premium: true, Promo: false, Ouvert247: true, Latitude: 28.5080, Longitude: -16.1780 },
            { id: "3", Nom: "Noche Latina SBK Tenerife", Categorie: "Soirées Salsa, Bachata & Kizomba", Zone: "Sud", Telephone: "+34622445566", Description: "Soirée Salsa et Bachata.", Premium: true, Promo: true, Ouvert247: false, Latitude: 28.0500, Longitude: -16.7100 },
            { id: "4", Nom: "Papagayo Beach Club", Categorie: "Discothèques & Clubs de Nuit", Zone: "Sud", Telephone: "+34922790011", Description: "Club incontournable en bord de mer.", Premium: true, Promo: true, Ouvert247: false, Latitude: 28.0620, Longitude: -16.7280 },
            { id: "5", Nom: "Green House Cannabis Club", Categorie: "Coffee Shops & Cannabis Clubs", Zone: "Sud", Telephone: "+34633889900", Description: "Social club privé.", Premium: false, Promo: false, Ouvert247: true, Latitude: 28.0550, Longitude: -16.7150 },
            { id: "6", Nom: "Le Privé Tenerife Club", Categorie: "Lieux Coquins & Clubs Privés", Zone: "Sud", Telephone: "+34677223344", Description: "Lounge bar et club libertin.", Premium: true, Promo: false, Ouvert247: false, Latitude: 28.0580, Longitude: -16.7200 },
            { id: "7", Nom: "Zenith Massage Sud", Categorie: "Bien-être & Massages", Zone: "Sud", Telephone: "+34611223344", Description: "Massages relaxants.", Premium: false, Promo: true, Ouvert247: false, Latitude: 28.0500, Longitude: -16.7100 },
            { id: "8", Nom: "Centro Médico Sur Los Cristianos", Categorie: "Santé, Médecins & Pharmacies", Zone: "Sud", Telephone: "+34922304050", Description: "Urgences médicales et pharmacie.", Premium: true, Promo: false, Ouvert247: true, Latitude: 28.0530, Longitude: -16.7120 },
            { id: "9", Nom: "Clinica Veterinaria 24h Adeje", Categorie: "Vétérinaires & Soins Animaliers", Zone: "Sud", Telephone: "+34922556677", Description: "Urgences vétérinaires 24h/24.", Premium: false, Promo: true, Ouvert247: true, Latitude: 28.0950, Longitude: -16.7250 },
            { id: "10", Nom: "Taxis Sur Tenerife 24h", Categorie: "Taxis, Transferts & Mobilité", Zone: "Sud", Telephone: "+34922445566", Description: "Réservation rapide de taxis.", Premium: true, Promo: false, Ouvert247: true, Latitude: 28.0400, Longitude: -16.7200 },
            { id: "11", Nom: "Vanlife Repair & Solar", Categorie: "Mécanique & Dépannage Van", Zone: "Sud", Telephone: "+34922112244", Description: "Installation solaire camping-car.", Premium: false, Promo: true, Ouvert247: false, Latitude: 28.0800, Longitude: -16.7000 },
            { id: "12", Nom: "Guachinche El Cordero", Categorie: "Restauration & Guachinches", Zone: "Sud", Telephone: "+34922667788", Description: "Cuisine traditionnelle canarienne.", Premium: true, Promo: true, Ouvert247: false, Latitude: 28.0700, Longitude: -16.6900 },
            { id: "13", Nom: "Eco Camper Park Tenerife", Categorie: "Hébergements & Vanlife", Zone: "Ouest", Telephone: "+34922889900", Description: "Aire de stationnement et services van.", Premium: false, Promo: true, Ouvert247: true, Latitude: 28.1500, Longitude: -16.8000 },
            { id: "14", Nom: "Tenerife Souvenirs & Bazar", Categorie: "Shopping & Souvenirs", Zone: "Sud", Telephone: "+34922003344", Description: "Boutique de souvenirs et articles de plage.", Premium: false, Promo: false, Ouvert247: true, Latitude: 28.0600, Longitude: -16.7200 }
        ];

        if (activeProfile) {
            demo = demo.filter(p => {
                const c = p.Categorie.toLowerCase();
                if (activeProfile === 'vanlife') return c.includes('vanlife') || c.includes('hébergement') || c.includes('mécanique');
                if (activeProfile === 'sbk') return c.includes('sbk') || c.includes('soirées');
                if (activeProfile === 'night') return c.includes('discothèques') || c.includes('bars de nuit') || c.includes('coquins') || c.includes('coffee shops');
                if (activeProfile === 'sante') return c.includes('santé') || c.includes('vétérinaires');
                if (activeProfile === 'touriste') return c.includes('plages') || c.includes('excursions') || c.includes('visites');
                if (activeProfile === 'zen') return c.includes('bien-être') || c.includes('massages');
                return true;
            });
        }

        const filtered = demo.filter(p => (!currentLetter || p.Nom.toUpperCase().startsWith(currentLetter)));
        renderGroupedCategories(filtered);
    }

    fetchPros();
</script>
</body>
</html>
